# Android build outputs
build/
.gradle/
*.apk
*.aab

# Android Studio IDE files
.idea/
*.iml

# Local configuration (contains machine-specific SDK path)
local.properties

# Gradle wrapper jar (large binary)
gradle/wrapper/gradle-wrapper.jar
**/gradle/wrapper/gradle-wrapper.jar

# Firebase — contains API keys, never commit
google-services.json

# Signing keystore — never commit
*.jks

# Raw promo recordings/audio — large binaries, some exceed GitHub's 100MB
# per-file limit; keep these local only
shared/promo/

# OS files
.DS_Store

# Unrelated files
FACEBOOK-GROUPS.md
